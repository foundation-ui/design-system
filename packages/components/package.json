{
  "name": "@usefui/components",
  "version": "1.6.0",
  "description": "Open Source React components library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run --coverage --logHeapUsage",
    "test:coverage": "open coverage/lcov-report/index.html",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc"
  },
  "keywords": [
    "react",
    "typescript",
    "accessibility",
    "ui",
    "components",
    "ui-components"
  ],
  "author": "Nicolas Nunes",
  "license": "MIT",
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "@types/styled-components": "*",
    "react": ">=16.8",
    "react-dom": ">=16.8",
    "styled-components": ">=5.1.34"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@usefui/core": "workspace:^",
    "@usefui/hooks": "workspace:^",
    "@usefui/tokens": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^5.3.11",
    "typescript": "^5.9.3"
  }
}
